{
  "run_name": "example_run",
  "seed": 1337,
  "device": "mps",
  "output_dir": "checkpoints",
  "top_k": 2,
  "pretrained": {
    "name_or_path": "base",
    "load_encoder_only": true,
    "strict": true,
    "freeze_encoder": true,
    "download_root": null
  },
  "data": {
    "train_dirs": ["datasets/train"],
    "val_dirs": ["datasets/val"],
    "label_to_index": {
      "normal": 0,
      "crackle": 1,
      "wheeze": 2
    },
    "sample_rate": 16000,
    "clip_seconds": 30.0,
    "source_type": "original",
    "bandpass": {
      "enabled": false,
      "low_freq": 250.0,
      "high_freq": 1000.0,
      "q": 0.707
    },
    "batch_size": 2,
    "num_workers": 0
  },
  "model": {
    "n_mels": 80,
    "n_audio_ctx": 1500,
    "n_audio_state": 384,
    "n_audio_head": 6,
    "n_audio_layer": 4,
    "pooling": "mean",
    "use_weighted_layer_sum": false,
    "classifier_proj_size": 256
  },
  "training": {
    "epochs": 2,
    "learning_rate": 0.0005,
    "weight_decay": 0.01,
    "warmup_ratio": 0.05,
    "max_grad_norm": 1.0
  },
  "threshold_optimization": {
    "enabled": false,
    "metric": "f1"
  }
}
