{
  "experiment": {
    "name": "wheeze_mil_sliding_attention_cv",
    "task": "normal_vs_wheeze",
    "mode": "mil",
    "seed": 42,
    "device": "mps",
    "output_dir": "checkpoints"
  },
  "data": {
    "train_dirs": [],
    "val_dirs": [],
    "eval_dirs": [],
    "label_to_index": {
      "normal": 0,
      "wheeze": 1
    },
    "batch_size": 4,
    "num_workers": 0,
    "audio": {
      "sample_rate": 16000,
      "clip_duration_sec": 30.0
    },
    "preprocessing": {
      "feature_type": "log_mel",
      "source_type": "original",
      "n_mels": 80,
      "bandpass": {
        "enabled": false,
        "low_hz": 250.0,
        "high_hz": 1000.0,
        "q": 0.707
      }
    },
    "segment": {
      "mode": "sliding_window",
      "length_sec": 2.0,
      "stride_sec": 1.0,
      "pad_last": true,
      "drop_last": false
    }
  },
  "model": {
    "segment_encoder": {
      "type": "whisper",
      "backbone": "tiny",
      "pretrained_name_or_path": "tiny",
      "strict": true,
      "download_root": null,
      "dims": {
        "n_audio_state": 384,
        "n_audio_head": 6,
        "n_audio_layer": 4
      },
      "pooling": {
        "type": "attention",
        "hidden_dim": 128,
        "dropout": 0.2,
        "gated": true
      },
      "adaptation": {
        "mode": "partial",
        "num_layers": 1
      }
    },
    "instance_head": {
      "type": "mlp",
      "hidden_dim": 256,
      "dropout": 0.2
    },
    "mil": {
      "aggregator": "attention",
      "attention": {
        "hidden_dim": 128,
        "dropout": 0.2,
        "gated": true
      },
      "topk": {
        "k": 3
      }
    }
  },
  "train": {
    "epochs": 100,
    "top_k": 3,
    "max_grad_norm": 0.5,
    "optimizer": {
      "encoder_lr": 1e-05,
      "head_lr": 5e-05,
      "weight_decay": 0.01
    },
    "scheduler": {
      "warmup_ratio": 0.15
    },
    "loss": {
      "type": "focal",
      "gamma": 2.0,
      "auto_pos_weight": false,
      "pos_weight": null
    },
    "sampler": {
      "weighted_random": true
    },
    "early_stopping": {
      "enabled": true,
      "monitor": "val_loss",
      "patience": 15,
      "min_delta": 0.0001
    }
  },
  "analysis": {
    "outputs": {
      "save_segment_scores": true,
      "save_instance_logits": true,
      "save_intra_attention_weights": true,
      "save_inter_attention_weights": true,
      "save_topk_indices": false,
      "save_bag_metadata": true
    }
  },
  "folds": [
    {
      "name": "fold_0",
      "train_dirs": [
        "datasets/folds/fold_1/",
        "datasets/folds/fold_2/",
        "datasets/folds/fold_3/",
        "datasets/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/folds/fold_0/"
      ]
    },
    {
      "name": "fold_1",
      "train_dirs": [
        "datasets/folds/fold_0/",
        "datasets/folds/fold_2/",
        "datasets/folds/fold_3/",
        "datasets/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/folds/fold_1/"
      ]
    },
    {
      "name": "fold_2",
      "train_dirs": [
        "datasets/folds/fold_0/",
        "datasets/folds/fold_1/",
        "datasets/folds/fold_3/",
        "datasets/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/folds/fold_2/"
      ]
    },
    {
      "name": "fold_3",
      "train_dirs": [
        "datasets/folds/fold_0/",
        "datasets/folds/fold_1/",
        "datasets/folds/fold_2/",
        "datasets/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/folds/fold_3/"
      ]
    },
    {
      "name": "fold_4",
      "train_dirs": [
        "datasets/folds/fold_0/",
        "datasets/folds/fold_1/",
        "datasets/folds/fold_2/",
        "datasets/folds/fold_3/"
      ],
      "val_dirs": [
        "datasets/folds/fold_4/"
      ]
    }
  ]
}
