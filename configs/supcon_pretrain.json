{
  "run_name": "supcon_pretrain",
  "seed": 1337,
  "device": "mps",
  "output_dir": "checkpoints/for_wheeze",
  "top_k": 2,
  "pretrained": {
    "name_or_path": "tiny",
    "load_encoder_only": true,
    "strict": true,
    "freeze_encoder": false,
    "download_root": null
  },
  "data": {
    "train_dirs": [
      "datasets/for_wheeze/remove_crackle/folds/fold_0",
      "datasets/for_wheeze/remove_crackle/folds/fold_1",
      "datasets/for_wheeze/remove_crackle/folds/fold_2",
      "datasets/for_wheeze/remove_crackle/folds/fold_3",
      "datasets/for_wheeze/remove_crackle/folds/fold_4"
    ],
    "val_dirs": [
      "datasets/for_wheeze/remove_crackle/folds/fold_4"
    ],
    "label_to_index": {
      "non_wheeze": 0,
      "wheeze": 1
    },
    "sample_rate": 16000,
    "clip_seconds": 30.0,
    "source_type": "original",
    "bandpass": {
      "enabled": false,
      "low_freq": 250.0,
      "high_freq": 1000.0,
      "q": 0.707
    },
    "batch_size": 64,
    "num_workers": 0
  },
  "encoder": {
    "n_mels": 80,
    "n_audio_ctx": 1500,
    "n_audio_state": 384,
    "n_audio_head": 6,
    "n_audio_layer": 4
  },
  "training": {
    "epochs": 200,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "warmup_ratio": 0.05,
    "max_grad_norm": 1.0
  },
  "supervised_contrastive": {
    "temperature": 0.07,
    "normalize": true,
    "projection_head": {
      "hidden_dim": 512,
      "output_dim": 128
    },
    "augmentation": {
      "time_mask_param": 40,
      "time_mask_count": 2,
      "freq_mask_param": 8,
      "freq_mask_count": 2,
      "gaussian_noise_std": 0.01
    }
  }
}
