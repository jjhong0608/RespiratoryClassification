{
  "run_name": "finetune_example",
  "seed": 1337,
  "device": "mps",
  "output_dir": "checkpoints",
  "top_k": 3,
  "finetune": {
    "checkpoint_path": "checkpoints/cv_colored_5fold_tiny/fold_0/last.pt",
    "encoder_lr": 0.00001,
    "classifier_lr": 0.0001,
    "unsafe_pickle_load": false
  },
  "data": {
    "train_dirs": ["datasets/folds/fold_0"],
    "val_dirs": ["datasets/folds/fold_1"],
    "label_to_index": {
      "Airway_disease_group": 0,
      "Lung_parenchymal_disease_group": 1
    },
    "sample_rate": 16000,
    "clip_seconds": 30.0,
    "source_type": "original",
    "bandpass": {
      "enabled": false,
      "low_freq": 250.0,
      "high_freq": 1000.0,
      "q": 0.707
    },
    "batch_size": 8,
    "num_workers": 0
  },
  "training": {
    "epochs": 10,
    "learning_rate": 0.0005,
    "weight_decay": 0.01,
    "warmup_ratio": 0.05,
    "max_grad_norm": 1.0
  },
  "threshold_optimization": {
    "enabled": false,
    "metric": "f1"
  }
}
