{
  "experiment": {
    "name": "Cross-Validation_Disease_Group",
    "task": "Normal_vs_Airway_vs_LungParenchymal",
    "mode": "clip",
    "seed": 1337,
    "device": "mps",
    "output_dir": "checkpoints"
  },
  "data": {
    "train_dirs": [],
    "val_dirs": [],
    "eval_dirs": [],
    "label_to_index": {
      "Normal": 0,
      "Lung_Parenchymal": 1,
      "Airway": 2
    },
    "batch_size": 4,
    "num_workers": 0,
    "audio": {
      "sample_rate": 16000,
      "clip_duration_sec": 30.0
    },
    "preprocessing": {
      "source_type": "original",
      "bandpass": {
        "enabled": false,
        "low_hz": 250.0,
        "high_hz": 1000.0,
        "q": 0.707
      },
      "ast_fbank": {
        "num_mel_bins": 128,
        "max_length": 1024,
        "do_normalize": true,
        "mean": -4.2677393,
        "std": 4.5689974
      }
    }
  },
  "augmentation": {
    "enabled": true,
    "policy": {
      "type": "one_of",
      "choices": [
        {
          "name": "none",
          "probability": 0.1
        },
        {
          "name": "waveform",
          "probability": 0.35
        },
        {
          "name": "fbank",
          "probability": 0.35
        },
        {
          "name": "both_light",
          "probability": 0.2
        }
      ]
    },
    "waveform": {
      "enabled": true,
      "probability": 1.0,
      "gain": {
        "enabled": true,
        "probability": 0.4,
        "min_db": -2.0,
        "max_db": 2.0
      },
      "noise": {
        "enabled": true,
        "probability": 0.2,
        "snr_db_min": 20.0,
        "snr_db_max": 35.0
      },
      "time_shift": {
        "enabled": true,
        "probability": 0.3,
        "max_shift_fraction": 0.025,
        "mode": "zero_pad"
      }
    },
    "fbank": {
      "enabled": true,
      "probability": 1.0,
      "time_mask": {
        "enabled": true,
        "num_masks": 2,
        "max_width": 16
      },
      "freq_mask": {
        "enabled": true,
        "num_masks": 2,
        "max_width": 4
      },
      "mask_value": 0.0
    }
  },
  "model": {
    "encoder": {
      "type": "multiscale_rdt_ast",
      "adaptation": {
        "mode": "full",
        "num_layers": 0
      },
      "architecture": {
        "hidden_size": 320,
        "num_attention_heads": 8,
        "mlp_ratio": 2.0,
        "hidden_dropout_prob": 0.1,
        "attention_probs_dropout_prob": 0.1,
        "layer_norm_eps": 1e-6,
        "shared_stem_depth": 2,
        "adapter_depth": 3,
        "rdt": {
          "enabled": true,
          "steps": 4,
          "top_tokens_per_branch": 3,
          "gated_residual": true,
          "layerscale_init": 0.01,
          "evidence_score_source": "attention_weight",
          "exclude_branches_from_evidence": []
        },
        "evidence_pooling": {
          "type": "class_aware_branch_gated",
          "gate_hidden_size": null,
          "dropout": 0.15,
          "temperature": 1.0,
          "class_gate": {
            "mode": "query",
            "scorer": "diagonal",
            "global_residual": {
              "enabled": true,
              "init_scale": 0.1,
              "learnable": true
            },
            "evidence_auxiliary": {
              "enabled": true,
              "weight": 0.1
            }
          }
        },
        "token_augmentation": {
          "branch_event_dropout": {
            "enabled": true,
            "probability": 0.1,
            "mode": "zero_mask",
            "min_keep_tokens": 1
          },
          "selected_evidence_dropout": {
            "enabled": true,
            "probability": 0.1,
            "mode": "zero",
            "min_keep_per_branch": 1
          }
        },
        "patch_branches": [
          {
            "patch_size": [
              16,
              16
            ],
            "stride": [
              8,
              16
            ]
          },
          {
            "patch_size": [
              8,
              32
            ],
            "stride": [
              4,
              32
            ]
          },
          {
            "patch_size": [
              4,
              64
            ],
            "stride": [
              2,
              64
            ]
          },
          {
            "patch_size": [
              2,
              128
            ],
            "stride": [
              1,
              128
            ]
          }
        ]
      }
    },
    "classifier": {
      "type": "mlp",
      "hidden_dim": 512,
      "dropout": 0.15,
      "pooling": "latent_mean"
    }
  },
  "train": {
    "epochs": 100,
    "top_k": 3,
    "max_grad_norm": 1.0,
    "optimizer": {
      "encoder_lr": 2e-6,
      "head_lr": 1e-4,
      "weight_decay": 0.01
    },
    "scheduler": {
      "warmup_ratio": 0.05
    },
    "initialization": {
      "checkpoint_path": "checkpoints/test_CNUH_3classes/last_epoch120.pt",
      "load_model_state": false,
      "strict": true,
      "load_optimizer_state": false,
      "skip_mismatched_shapes": false
    },
    "loss": {
      "type": "cross_entropy",
      "auto_pos_weight": false,
      "pos_weight": null,
      "gamma": 2.0,
      "class_weighting": {
        "enabled": true,
        "type": "sqrt_inverse_frequency",
        "normalize": "mean_one",
        "source": "train"
      },
      "label_smoothing": {
        "enabled": false,
        "value": 0.05
      },
      "gate_entropy_regularization": {
        "enabled": false,
        "weight": 0.001,
        "target": "true_class_evidence_gate"
      },
      "class_gate_diversity_regularization": {
        "enabled": false,
        "weight": 0.0003,
        "target": "class_evidence_gate",
        "metric": "js_divergence"
      },
      "branch_auxiliary": {
        "enabled": false,
        "weight": 0.3,
        "aggregation": "mean"
      },
      "branch_binary_auxiliary": {
        "enabled": false,
        "weight": 0.3,
        "label_to_index": {
          "Normal": 0,
          "Lung_Parenchymal": 1,
          "Airway": 1
        },
        "pos_weight": {
          "enabled": true,
          "type": "sqrt_normal_over_abnormal",
          "source": "train"
        },
        "aggregation": "mean"
      }
    },
    "sampler": {
      "weighted_random": false
    },
    "early_stopping": {
      "enabled": true,
      "monitor": "val_loss",
      "patience": 30,
      "min_delta": 0.00001
    }
  },
  "val": {
    "loss": {
      "use_train_loss_config": true,
      "class_weight_source": "train",
      "binary_pos_weight_source": "train"
    }
  },
  "checkpointing": {
    "monitors": [
      {
        "name": "val_macro_f1",
        "mode": "max",
        "top_k": 3
      },
      {
        "name": "val_macro_recall",
        "mode": "max",
        "top_k": 3
      },
      {
        "name": "val_loss",
        "mode": "min",
        "top_k": 3
      },
      {
        "name": "last",
        "mode": "latest",
        "top_k": 3
      }
    ]
  },
  "analysis": {
    "outputs": {
      "save_logits": true,
      "save_probabilities": true,
      "save_embeddings": false,
      "save_clip_metadata": true
    }
  },
