{
  "experiment": {
    "name": "respiratory_multiscale_rdt_ast_cv",
    "task": "normal_vs_wheeze",
    "mode": "clip",
    "seed": 42,
    "device": "cpu",
    "output_dir": "checkpoints"
  },
  "data": {
    "train_dirs": [],
    "val_dirs": [],
    "eval_dirs": [],
    "label_to_index": {
      "normal": 0,
      "wheeze": 1
    },
    "batch_size": 4,
    "num_workers": 0,
    "audio": {
      "sample_rate": 16000,
      "clip_duration_sec": 30.0
    },
    "preprocessing": {
      "source_type": "original",
      "bandpass": {
        "enabled": false,
        "low_hz": 250.0,
        "high_hz": 1000.0,
        "q": 0.707
      },
      "ast_fbank": {
        "num_mel_bins": 128,
        "max_length": 1024,
        "do_normalize": true,
        "mean": -4.2677393,
        "std": 4.5689974
      }
    }
  },
  "model": {
    "encoder": {
      "type": "multiscale_rdt_ast",
      "adaptation": {
        "mode": "full",
        "num_layers": 0
      },
      "architecture": {
        "hidden_size": 384,
        "num_attention_heads": 6,
        "mlp_ratio": 4.0,
        "hidden_dropout_prob": 0.1,
        "attention_probs_dropout_prob": 0.1,
        "layer_norm_eps": 1e-6,
        "shared_stem_depth": 2,
        "adapter_depth": 1,
        "latent_query_count": 8,
        "rdt_steps": 3,
        "patch_branches": [
          {
            "patch_size": [16, 16],
            "stride": [8, 16]
          },
          {
            "patch_size": [8, 32],
            "stride": [4, 32]
          },
          {
            "patch_size": [4, 64],
            "stride": [2, 64]
          },
          {
            "patch_size": [2, 128],
            "stride": [1, 128]
          }
        ]
      }
    },
    "classifier": {
      "type": "mlp",
      "hidden_dim": 256,
      "dropout": 0.1,
      "pooling": "latent_mean"
    }
  },
  "train": {
    "epochs": 100,
    "top_k": 3,
    "max_grad_norm": 1.0,
    "optimizer": {
      "encoder_lr": 2e-5,
      "head_lr": 1e-4,
      "weight_decay": 0.01
    },
    "scheduler": {
      "warmup_ratio": 0.15
    },
    "loss": {
      "type": "focal",
      "auto_pos_weight": true,
      "pos_weight": null,
      "gamma": 2.0
    },
    "sampler": {
      "weighted_random": false
    },
    "early_stopping": {
      "enabled": true,
      "monitor": "val_loss",
      "patience": 15,
      "min_delta": 0.0001
    }
  },
  "analysis": {
    "outputs": {
      "save_logits": true,
      "save_probabilities": true,
      "save_embeddings": false,
      "save_clip_metadata": true
    }
  },
  "folds": [
    {
      "name": "fold_0",
      "train_dirs": [
        "datasets/clean_wheeze/folds/fold_1/",
        "datasets/clean_wheeze/folds/fold_2/",
        "datasets/clean_wheeze/folds/fold_3/",
        "datasets/clean_wheeze/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/clean_wheeze/folds/fold_0/"
      ]
    },
    {
      "name": "fold_1",
      "train_dirs": [
        "datasets/clean_wheeze/folds/fold_0/",
        "datasets/clean_wheeze/folds/fold_2/",
        "datasets/clean_wheeze/folds/fold_3/",
        "datasets/clean_wheeze/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/clean_wheeze/folds/fold_1/"
      ]
    },
    {
      "name": "fold_2",
      "train_dirs": [
        "datasets/clean_wheeze/folds/fold_0/",
        "datasets/clean_wheeze/folds/fold_1/",
        "datasets/clean_wheeze/folds/fold_3/",
        "datasets/clean_wheeze/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/clean_wheeze/folds/fold_2/"
      ]
    },
    {
      "name": "fold_3",
      "train_dirs": [
        "datasets/clean_wheeze/folds/fold_0/",
        "datasets/clean_wheeze/folds/fold_1/",
        "datasets/clean_wheeze/folds/fold_2/",
        "datasets/clean_wheeze/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/clean_wheeze/folds/fold_3/"
      ]
    },
    {
      "name": "fold_4",
      "train_dirs": [
        "datasets/clean_wheeze/folds/fold_0/",
        "datasets/clean_wheeze/folds/fold_1/",
        "datasets/clean_wheeze/folds/fold_2/",
        "datasets/clean_wheeze/folds/fold_3/"
      ],
