{
  "experiment": {
    "name": "wheeze_mil_sliding_attention_eval",
    "task": "normal_vs_wheeze",
    "mode": "mil",
    "seed": 42,
    "device": "mps",
    "output_dir": "checkpoints"
  },
  "checkpoint_path": "checkpoints/wheeze_mil_sliding_attention_cv/fold_0/last.pt",
  "threshold_optimization": {
    "enabled": true,
    "metric": "f1"
  },
  "data": {
    "train_dirs": [],
    "val_dirs": [],
    "eval_dirs": [
      "datasets/test/"
    ],
    "label_to_index": {
      "normal": 0,
      "wheeze": 1
    },
    "batch_size": 4,
    "num_workers": 0,
    "audio": {
      "sample_rate": 16000,
      "clip_duration_sec": 30.0
    },
    "preprocessing": {
      "feature_type": "log_mel",
      "source_type": "original",
      "n_mels": 80,
      "bandpass": {
        "enabled": false,
        "low_hz": 250.0,
        "high_hz": 1000.0,
        "q": 0.707
      }
    },
    "segment": {
      "mode": "sliding_window",
      "length_sec": 5.0,
      "stride_sec": 2.5,
      "pad_last": true,
      "drop_last": false
    }
  },
  "analysis": {
    "outputs": {
      "save_segment_scores": true,
      "save_instance_logits": true,
      "save_intra_attention_weights": true,
      "save_inter_attention_weights": true,
      "save_topk_indices": false,
      "save_bag_metadata": true
    }
  }
}
