{
  "experiment": {
    "name": "wheeze_mil_sliding_topk_cv",
    "task": "normal_vs_wheeze",
    "mode": "mil",
    "seed": 42,
    "device": "mps",
    "output_dir": "checkpoints"
  },
  "data": {
    "train_dirs": [],
    "val_dirs": [],
    "eval_dirs": [],
    "label_to_index": {
      "normal": 0,
      "wheeze": 1
    },
    "batch_size": 4,
    "num_workers": 0,
    "audio": {
      "sample_rate": 16000,
      "clip_duration_sec": 30.0
    },
    "preprocessing": {
      "feature_type": "log_mel",
      "source_type": "original",
      "bandpass": {
        "enabled": false,
        "low_hz": 250.0,
        "high_hz": 1000.0,
        "q": 0.707
      },
      "log_mel": {
        "n_fft": 400,
        "hop_length": 160,
        "win_length": 400,
        "n_mels": 80
      },
      "ast_fbank": {
        "num_mel_bins": 128,
        "max_length": 1024,
        "do_normalize": true,
        "mean": -4.2677393,
        "std": 4.5689974
      }
    },
    "segment": {
      "mode": "sliding_window",
      "length_sec": 5.0,
      "stride_sec": 2.5,
      "pad_last": true,
      "drop_last": false
    }
  },
  "model": {
    "segment_encoder": {
      "type": "whisper",
      "backbone": "base",
      "pretrained_name_or_path": "base",
      "strict": true,
      "download_root": null,
      "dims": {
        "n_audio_state": 512,
        "n_audio_head": 8,
        "n_audio_layer": 6
      },
      "pooling": {
        "type": "attention",
        "hidden_dim": 128,
        "dropout": 0.1,
        "gated": true
      },
      "adaptation": {
        "mode": "partial",
        "num_layers": 1
      }
    },
    "instance_head": {
      "type": "linear",
      "hidden_dim": 256,
      "dropout": 0.1
    },
    "mil": {
      "aggregator": "topk",
      "attention": {
        "hidden_dim": 128,
        "dropout": 0.1,
        "gated": true
      },
      "topk": {
        "k": 3
      }
    }
  },
  "train": {
    "epochs": 100,
    "top_k": 3,
    "max_grad_norm": 1.0,
    "optimizer": {
      "encoder_lr": 2e-05,
      "head_lr": 0.0001,
      "weight_decay": 0.01
    },
    "scheduler": {
      "warmup_ratio": 0.05
    },
    "loss": {
      "type": "bce",
      "auto_pos_weight": true,
      "pos_weight": null
    },
    "sampler": {
      "weighted_random": true
    },
    "early_stopping": {
      "enabled": true,
      "monitor": "val_loss",
      "patience": 15,
      "min_delta": 0.0001
    }
  },
  "analysis": {
    "outputs": {
      "save_segment_scores": true,
      "save_instance_logits": true,
      "save_intra_attention_weights": true,
      "save_inter_attention_weights": false,
      "save_topk_indices": true,
      "save_bag_metadata": true
    }
  },
  "folds": [
    {
      "name": "fold_0",
      "train_dirs": [
        "datasets/folds/fold_1/",
        "datasets/folds/fold_2/",
        "datasets/folds/fold_3/",
        "datasets/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/folds/fold_0/"
      ]
    },
    {
      "name": "fold_1",
      "train_dirs": [
        "datasets/folds/fold_0/",
        "datasets/folds/fold_2/",
        "datasets/folds/fold_3/",
        "datasets/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/folds/fold_1/"
      ]
    },
    {
      "name": "fold_2",
      "train_dirs": [
        "datasets/folds/fold_0/",
        "datasets/folds/fold_1/",
        "datasets/folds/fold_3/",
        "datasets/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/folds/fold_2/"
      ]
    },
    {
      "name": "fold_3",
      "train_dirs": [
        "datasets/folds/fold_0/",
        "datasets/folds/fold_1/",
        "datasets/folds/fold_2/",
        "datasets/folds/fold_4/"
      ],
      "val_dirs": [
        "datasets/folds/fold_3/"
      ]
    },
    {
      "name": "fold_4",
      "train_dirs": [
        "datasets/folds/fold_0/",
        "datasets/folds/fold_1/",
        "datasets/folds/fold_2/",
        "datasets/folds/fold_3/"
      ],
      "val_dirs": [
        "datasets/folds/fold_4/"
      ]
    }
  ]
}
