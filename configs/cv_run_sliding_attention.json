{
  "experiment": {
    "name": "wheeze_mil_sliding_attention_cv",
    "task": "normal_vs_wheeze",
    "mode": "mil",
    "seed": 42,
    "device": "mps",
    "output_dir": "checkpoints"
  },
  "data": {
    "train_dirs": [],
    "val_dirs": [],
    "eval_dirs": [],
    "label_to_index": {
      "normal": 0,
      "wheeze": 1
    },
    "batch_size": 4,
    "num_workers": 0,
    "audio": {
      "sample_rate": 16000,
      "clip_duration_sec": 30.0
    },
    "preprocessing": {
      "feature_type": "log_mel",
      "source_type": "original",
      "n_mels": 80,
      "bandpass": {
        "enabled": false,
        "low_hz": 250.0,
        "high_hz": 1000.0,
        "q": 0.707
      }
    },
    "segment": {
      "mode": "sliding_window",
      "length_sec": 5.0,
      "stride_sec": 2.5,
      "pad_last": true,
      "drop_last": false
    }
  },
  "model": {
    "encoder": {
      "type": "whisper",
      "backbone": "base",
      "pretrained_name_or_path": "base",
      "freeze": false,
      "strict": true,
      "download_root": null,
      "n_audio_state": 512,
      "n_audio_head": 8,
      "n_audio_layer": 6
    },
    "instance_head": {
      "type": "mlp",
      "hidden_dim": 256,
      "dropout": 0.1
    },
    "mil": {
      "aggregator": "attention",
      "return_instance_scores": true,
      "topk": {
        "k": 3
      },
      "attention": {
        "hidden_dim": 128,
        "dropout": 0.1,
        "gated": true
      },
      "logsumexp": {
        "temperature": 1.0
      },
      "softmax_weighted": {
        "temperature": 1.0
      },
      "noisy_or": {
        "clamp_eps": 1e-6
      }
    }
  },
  "train": {
    "epochs": 100,
    "top_k": 3,
    "warmup_ratio": 0.05,
    "max_grad_norm": 1.0,
    "optimizer": {
      "lr": 0.0001,
      "weight_decay": 0.01
    },
    "loss": {
      "type": "bce",
      "auto_pos_weight": true,
      "pos_weight": null
    },
    "sampler": {
      "weighted_random": true
    }
  },
  "analysis": {
    "outputs": {
      "save_segment_scores": true,
      "save_attention_weights": true,
      "save_topk_indices": true,
      "save_bag_metadata": true
    }
  },
  "folds": [
    {
      "name": "fold_0",
      "train_dirs": ["datasets/folds/fold_1/", "datasets/folds/fold_2/", "datasets/folds/fold_3/", "datasets/folds/fold_4/"],
      "val_dirs": ["datasets/folds/fold_0/"]
    },
    {
      "name": "fold_1",
      "train_dirs": ["datasets/folds/fold_0/", "datasets/folds/fold_2/", "datasets/folds/fold_3/", "datasets/folds/fold_4/"],
      "val_dirs": ["datasets/folds/fold_1/"]
    },
    {
      "name": "fold_2",
      "train_dirs": ["datasets/folds/fold_0/", "datasets/folds/fold_1/", "datasets/folds/fold_3/", "datasets/folds/fold_4/"],
      "val_dirs": ["datasets/folds/fold_2/"]
    },
    {
      "name": "fold_3",
      "train_dirs": ["datasets/folds/fold_0/", "datasets/folds/fold_1/", "datasets/folds/fold_2/", "datasets/folds/fold_4/"],
      "val_dirs": ["datasets/folds/fold_3/"]
    },
    {
      "name": "fold_4",
      "train_dirs": ["datasets/folds/fold_0/", "datasets/folds/fold_1/", "datasets/folds/fold_2/", "datasets/folds/fold_3/"],
      "val_dirs": ["datasets/folds/fold_4/"]
    }
  ]
}
