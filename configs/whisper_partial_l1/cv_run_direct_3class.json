    "loss": {
      "type": "cross_entropy",
      "auto_pos_weight": false,
      "pos_weight": null,
      "gamma": 2.0
    },
    "sampler": {
      "weighted_random": true
    },
    "early_stopping": {
      "enabled": true,
      "monitor": "val_loss",
      "patience": 15,
      "min_delta": 0.0001
    }
  },
  "analysis": {
